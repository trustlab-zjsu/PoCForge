  }
  /* Smart Contract Owner Can Update Buy Fee */
  function updateBuyFee(uint buyTaxFee, uint LiquidityBuyPer, uint marketingBuyPer, uint RewardBuyPer, uint autoBurnBuyPer) onlyOwner public {
    _buyTaxFee = buyTaxFee;
    _LiquidityBuyPer = LiquidityBuyPer;
    _marketingBuyPer = marketingBuyPer;
    _RewardBuyPer = RewardBuyPer;
