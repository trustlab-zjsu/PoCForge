    _decimals = 18;
    _sellTaxFee = 2;
    _buyTaxFee = 0;
    _previousSellTaxFee = 0;
    _previousBuyTaxFee = 0;
    _LiquidityBuyPer = 0;
    _LiquiditySellPer = 0;
    _marketingBuyPer = 0;
    _marketingSellPer = 1;
    _RewardBuyPer = 0;
    _RewardSellPer = 1;
    _autoBurnBuyPer = 0;
    _autoBurnSellPer = 0;
