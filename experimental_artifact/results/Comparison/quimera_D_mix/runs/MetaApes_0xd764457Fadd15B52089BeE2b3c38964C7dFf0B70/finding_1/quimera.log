  function setvariable(uint256 _cvariable, uint256 _stvariable, uint256 _yvariable, uint256 _xvariable, uint256 _bvariable, uint256 _zvariable) external authorized {
    cr = _cvariable;
    st = _stvariable;
    xr = _xvariable;
    yr = _yvariable;
    br = _bvariable;
    zr = _zvariable;
  }

  function cSb(uint256 aP) external authorized {
