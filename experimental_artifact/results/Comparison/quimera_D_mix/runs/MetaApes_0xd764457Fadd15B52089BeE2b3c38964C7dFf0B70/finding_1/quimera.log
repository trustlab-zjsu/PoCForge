    uint256 acBNBs = acBNBa.mul(csb2).div(100);
    uint256 acBNBt = acBNBa.mul(csb3).div(100);
    uint256 acBNBl = acBNBa.mul(csb4).div(100);
    (bool tmpSuccess, ) = payable(krhF).call {
      value: acBNBf,
      gas: gss
    }("");
    (tmpSuccess, ) = payable(mdhS).call {
      value: acBNBs,
      gas: gss
    }("");
    (tmpSuccess, ) = payable(wthT).call {
      value: acBNBt,
      gas: gss
    }("");
    (tmpSuccess, ) = payable(extR).call {
      value: acBNBl,
      gas: gss
    }("");
    tmpSuccess = false;
